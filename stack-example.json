{
    "$schema": "./stack.schema.json",
    "vram_capacity_gb": 16,
    "launchers": [
        {
            "name": "llm_main",
            "type": "text-generation",
            "description": "Main text generation model with extended context and reasoning",
            "command": "/usr/local/bin/llama-server -m /opt/models/example-model.gguf --ctx-size 262144 --reasoning-budget 6144 --models-max 1 --parallel 1 --host 127.0.0.1 --port 8080",
            "vram_gb": 14,
            "health": {
                "url": "http://127.0.0.1:8080/health"
            }
        },
        {
            "name": "llm_flash",
            "type": "text-generation",
            "description": "Lightweight model for quick requests",
            "command": "/opt/scripts/run_llm.sh -f",
            "vram_gb": 8,
            "process_match": "flash-model.gguf"
        },
        {
            "name": "comfyui",
            "type": "image",
            "description": "ComfyUI workflows",
            "command": "/opt/comfyui/venv/bin/python main.py --listen 127.0.0.1 --port 8188",
            "cwd": "/opt/comfyui/ComfyUI",
            "vram_gb": 14,
            "stop_timeout_seconds": 30,
            "health": {
                "url": "http://127.0.0.1:8188/system_stats",
                "timeout_seconds": 120
            }
        },
        {
            "name": "embedding",
            "type": "embedding",
            "description": "bge-m3, CPU only",
            "command": "/usr/local/bin/llama-server -m /opt/models/embbed_model.gguf --embedding --pooling mean --n-gpu-layers 0 --host 127.0.0.1 --port 8081",
            "gpu": false,
            "health": {
                "url": "http://127.0.0.1:8081/health"
            }
        },
        {
            "name": "rerank",
            "type": "rerank",
            "description": "Small reranker kept on the GPU next to the main model",
            "command": "/usr/local/bin/llama-server -m /opt/models/rerank_model.gguf --reranking --pooling rank --n-gpu-layers 30 --host 127.0.0.1 --port 8082",
            "vram_gb": 0.6,
            "exclusive": false,
            "health": {
                "url": "http://127.0.0.1:8082/health"
            }
        },
        {
            "name": "tts",
            "type": "text-to-speech",
            "description": "Speech synthesis from text",
            "command": "/opt/scripts/run_tts",
            "cwd": "~/tts",
            "env": { "TTS_DEVICE": "cpu" },
            "gpu": false
        }
    ]
}
